{
  "manifest_version": 3,
  "name": "romplin-recipe",
  "version": "1.0.0",
  "description": "Strip recipe sites down to just ingredients and directions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}
